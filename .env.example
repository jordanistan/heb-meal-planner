# Copy to .env for local runs. Compose/k8s set these via their own config.
ENVIRONMENT=development

# Local dev/tests default to SQLite if this is unset.
# DATABASE_URL=sqlite:///./dev.db
# Postgres (as Docker Compose uses):
# DATABASE_URL=postgresql+psycopg://heb:heb@db:5432/heb

# Optional: enables Claude-generated plans. v1 works fully without it.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
